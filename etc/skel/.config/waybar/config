{
  "layer": "top",
  "height": 30,
  "width": "auto",
  "margin": 4,

  "modules-left": ["custom/about", "hyprland/workspaces"],

  "modules-center": ["hyprland/window"],

  "modules-right": [
    "custom/menu",
    "custom/help",
    "pulseaudio",
    "cpu",
    "memory",
    "battery",
    "clock",
    "network",
    "custom/power",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "custom/menu": {
    "format": "󰣇 ",
    "tooltip": true,
    "tooltip-format": "Aplicativos",
    "on-click": "nwggrid"
  },

  "custom/help": {
    "format": "󰘥 ",
    "tooltip": true,
    "tooltip-format": "VoidBR Hyprland Shortcuts\nClique ou pressione Super+F1",
    "on-click": "voidbr-hyprland-shortcuts"
  },

  "custom/wallpaper": {
    "format": " ",
    "on-click": "/usr/local/bin/voidbr-change-wallpaper"
  },

  "custom/about": {
    "format": " VoidBR",
    "tooltip": true,
    "tooltip-format": "Sobre o VoidBR e o sistema",
    "on-click": "hyprsysteminfo"
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 Ethernet",
    "format-disconnected": "󰖪 Offline",
    "on-click": "nm-connection-editor"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": " {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "tray": {
    "spacing": 10
  },

  "clock": {
    "timezone": "America/Sao_Paulo",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><big>{calendar}</big></tt>",
    "format-alt": "{:%a %d-%m-%Y}"
  },

  "cpu": {
    "format": "{usage}% ",
    "on-click": "gnome-system-monitor"
  },

  "memory": {
    "format": "󰍛 {}% ",
    "on-click": "foot -e htop"
  },

  "pulseaudio": {
    "format": "{volume}% {icon}    {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "nwg-bar"
  }
}
